# Copy this file to .env and fill in the 4 values marked FILL. Keep everything else.
# Run all npm commands from this folder:  ~/hackathon/agentbazaar/app

# ---- Chain ----
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
# Filled in after "npm run deploy" prints the address
REGISTRY_ADDRESS=

# ---- Wallets (Fuji testnet only, throwaway wallets, never a real one) ----
# FILL: private key of the orchestrator wallet (pays agents, posts ratings, deploys). With or without 0x.
PRIVATE_KEY=
# FILL: address of the provider wallet (receives the USDC). Starts with 0x.
PROVIDER_ADDRESS=
# Optional. Leave empty to reuse PRIVATE_KEY for settling x402 payments.
FACILITATOR_PRIVATE_KEY=

# ---- Keys ----
# FILL one LLM key. Claude is used if ANTHROPIC_API_KEY is set, otherwise OpenAI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# FILL: any non-empty value works for Snowtrace/Routescan verification
SNOWTRACE_API_KEY=verifyContract

# ---- Payments: avax (native AVAX, default), x402 (USDC via x402), or direct (USDC transfer) ----
PAY_MODE=avax
FACILITATOR_URL=http://localhost:4100

# ---- Misc ----
MODEL=claude-opus-5
ORCHESTRATOR_PORT=3000
MOCK_LLM=0
